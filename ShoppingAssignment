package shoppingassignment;
import java.util.ArrayList;
import java.util.Scanner;
/**
 *
 * @author tvandillen2028
 */

class Item {
private String name;
    private double price;

    public Item(String name, double price) {
        this.name = name;
        this.price = price;
    }

    public String getName() {
        return name;
    }

    public double getPrice() {
        return price;
    }

    @Override
    public String toString() {
        return name + " - $" + String.format("%.2f", price);
    }
}


public class ShoppingAssignment {
    
    /**
     * @param args the command line arguments
     */
    public static void main(String[] args) {
        // TODO code application logic here
    Scanner scanner = new Scanner(System.in);
    ArrayList<Item> list = new ArrayList<>();
    System.out.println("=== Shopping List Manager ===");

        // 1. Get items and prices from user
        while (true) {
            System.out.print("Enter item name (or type 'done' to finish): ");
            String name = scanner.nextLine().trim();

            if (name.equalsIgnoreCase("done")) {
                break;
            }

            System.out.print("Enter price for " + name + ": $");
            double price = Double.parseDouble(scanner.nextLine().trim());

            (new Item(name, price));
            System.out.println();
        }

        if (list.isEmpty()) {
            System.out.println("\nNo items were added to the list.");
            scanner.close();
            return;
        }

        // 2. Display the initial shopping list & total
        displayList(list);

        // 3. Allow user to remove an item by number
        System.out.print("\nEnter the number of the item to remove (or 0 to keep all): ");
        int removeIndex = Integer.parseInt(scanner.nextLine().trim());

        if (removeIndex > 0 && removeIndex <= list.size()) {
            Item removedItem = list.remove(removeIndex - 1);
            System.out.println("\nRemoved: " + removedItem.getName());
        } else if (removeIndex != 0) {
            System.out.println("\nInvalid item number. No item was removed.");
        }

        // 4. Redisplay the updated list & total
        System.out.println("\n=== Updated Shopping List ===");
        displayList(list);

        scanner.close();
    }

    /**
     * Helper method to print the numbered items and calculate total cost.
     */
    private static void displayList(ArrayList<Item> items) {
        if (items.isEmpty()) {
            System.out.println("Your shopping list is now empty.");
            System.out.println("Total Cost: $0.00");
            return;
        }

        System.out.println("\n--- Current Items ---");
        double totalCost = 0;

        for (int i = 0; i < items.size(); i++) {
            Item item = items.get(i);
            System.out.println((i + 1) + ". " + item.toString());
            totalCost += item.getPrice();
            
        }

        System.out.println("---------------------");
        System.out.printf("Total Cost: $%.2f%n", totalCost);
    }
}
    
    
    

